{
  "name": "agent-wechat-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "WeChat shell for AI agents — connect any agent to WeChat via the official iLink protocol",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "wechat:login": "pnpm --filter @agent-wechat/cli run login",
    "wechat:start": "pnpm --filter @agent-wechat/cli run start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
